    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 6,
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
