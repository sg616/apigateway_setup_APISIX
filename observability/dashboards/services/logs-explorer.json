{
 "uid": "logs-explorer",
 "title": "Logs explorer",
 "description": "Loki logs of sample-app, apisix and observability. Gateway panels parse the APISIX JSON access log. Generated by observability/dashboards/build.py; edit there, not in the UI.",
 "tags": [
  "logs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "editable": false,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "custom",
    "query": "sample-app,apisix,observability",
    "includeAll": true,
    "multi": true,
    "allValue": "sample-app|apisix|observability",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "app",
    "label": "App",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values({namespace=~\"$namespace\"}, app)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Log lines / s by app",
   "description": null,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (app) (rate({namespace=~\"$namespace\", app=~\"$app\"}[1m]))",
     "legendFormat": "{{app}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "ERROR / WARN lines per minute",
   "description": null,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (app) (count_over_time({namespace=~\"$namespace\", app=~\"$app\"} |~ \"(?i)\\\\b(ERROR|Exception)\\\\b\" [1m])) or vector(0)",
     "legendFormat": "{{app}} error"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (app) (count_over_time({namespace=~\"$namespace\", app=~\"$app\"} |~ \"\\\\bWARN\\\\b\" [1m])) or vector(0)",
     "legendFormat": "{{app}} warn"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 2,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "table",
   "title": "Top error messages (1h)",
   "description": "Spring Boot lines grouped by the first 140 characters from the level on.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "topk(15, sum by (app, msg) (count_over_time({namespace=~\"$namespace\", app=~\"$app\"} |~ \"\\\\b(ERROR|WARN)\\\\b\" | regexp \"(?P<msg>(ERROR|WARN).{0,140})\" [1h])))",
     "instant": true,
     "format": "table",
     "legendFormat": "count"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 9
   }
  },
  {
   "id": 4,
   "type": "row",
   "title": "Gateway access log",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Gateway 4xx / 5xx by path",
   "description": null,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (path, status) (count_over_time({namespace=\"apisix\", container=\"apisix\"} |= \"\\\"client_ip\\\"\" | json | __error__=\"\" | status >= 400 [5m]))",
     "legendFormat": "{{status}} {{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "table",
   "title": "Top client IPs (1h)",
   "description": null,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "topk(10, sum by (client_ip) (count_over_time({namespace=\"apisix\", container=\"apisix\"} |= \"\\\"client_ip\\\"\" | json | __error__=\"\" [1h])))",
     "instant": true,
     "format": "table",
     "legendFormat": "requests"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 6,
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "table",
   "title": "Slowest paths (1h): requests over 1 s",
   "description": "Empty when nothing took longer than 1 s.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "topk(10, sum by (path) (count_over_time({namespace=\"apisix\", container=\"apisix\"} |= \"\\\"client_ip\\\"\" | json | __error__=\"\" | request_time > 1 [1h])))",
     "instant": true,
     "format": "table",
     "legendFormat": "slow requests"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "logs",
   "title": "Slow gateway requests (> 1 s)",
   "description": null,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{namespace=\"apisix\", container=\"apisix\"} |= \"\\\"client_ip\\\"\" | json | __error__=\"\" | request_time > 1"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   },
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 8
   }
  },
  {
   "type": "logs",
   "title": "Live logs (filtered by the variables)",
   "description": null,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{namespace=~\"$namespace\", app=~\"$app\"}"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 24,
    "h": 14
   }
  }
 ]
}