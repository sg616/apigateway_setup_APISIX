{
 "uid": "gateway-overview",
 "title": "Gateway overview: metrics, logs, traces",
 "tags": [
  "apisix",
  "gateway"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "editable": false,
 "panels": [
  {
   "type": "stat",
   "title": "Requests / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(apisix_http_status[5m]))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "5xx share",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(apisix_http_status{code=~\"5..\"}[5m])) / clamp_min(sum(rate(apisix_http_status[5m])), 1e-9)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 2,
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "429 / min (rate limited)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "60 * sum(rate(apisix_http_status{code=\"429\"}[5m]))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 500
       },
       {
        "color": "red",
        "value": 1000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 4,
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "timeseries",
   "title": "Requests / s by path",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (matched_uri) (rate(apisix_http_status[5m]))",
     "legendFormat": "{{matched_uri}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Responses by status code",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (code) (rate(apisix_http_status[5m]))",
     "legendFormat": "{{code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "id": 6,
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "p95 latency by service (from traces)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CLIENT\"}[5m])))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Errors by service (from traces)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "logs",
   "title": "Gateway errors: 5xx responses (click trace_id for the trace)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{namespace=\"apisix\", container=\"apisix\"} | json | status >= 500"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "logs",
   "title": "App errors and warnings (sample-app)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{namespace=\"sample-app\"} |~ \"(?i)\\\\b(ERROR|WARN|Exception)\\\\b\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "table",
   "title": "Recent slow or failed traces (click to open)",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ duration > 500ms || status = error }",
     "limit": 20,
     "tableType": "traces"
    }
   ],
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Memory by pod (working set)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"sample-app|apisix|observability\", container!=\"\", container!=\"POD\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "id": 12,
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Container restarts (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"sample-app|apisix|observability\"}[1h]))",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "id": 13,
   "gridPos": {
    "x": 12,
    "y": 37,
    "w": 12,
    "h": 8
   }
  }
 ],
 "description": "One screen for the APISIX gateway and the sample app. Provisioned from git (apigateway_setup_APISIX/observability/dashboards); edit there."
}