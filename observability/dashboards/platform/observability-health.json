{
 "uid": "observability-health",
 "title": "Observability stack health",
 "description": "Is the monitoring itself OK? Scrapes, ingestion of metrics/logs/traces, disk use. Alerting lives in AOM/LTS (docs/lts-alarms.md), because this stack shares the node with the app. Generated by observability/dashboards/build.py; edit there, not in the UI.",
 "tags": [
  "platform",
  "observability"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "editable": false,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "Scrape targets down",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(up == 0) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
