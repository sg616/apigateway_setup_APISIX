{
 "uid": "kubernetes-node",
 "title": "Kubernetes and node",
 "description": "Node (node-exporter), workloads (kube-state-metrics) and containers (cAdvisor) for the app, gateway and observability namespaces. Generated by observability/dashboards/build.py; edit there, not in the UI.",
 "tags": [
  "platform",
  "kubernetes"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "editable": false,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "gauge",
   "title": "Node CPU used",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 6
   }
  },
  {
   "type": "gauge",
   "title": "Node memory used",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 2,
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 6
   }
  },
  {
   "type": "gauge",
   "title": "Root disk used",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - sum(node_filesystem_avail_bytes{mountpoint=\"/\"}) / sum(node_filesystem_size_bytes{mountpoint=\"/\"}))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 6
   }
  },
  {
   "type": "stat",
   "title": "Pods not Running (3 ns)",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(kube_pod_status_phase{namespace=~\"sample-app|apisix|observability\", phase=~\"Pending|Failed|Unknown\"}) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 4,
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "timeseries",
   "title": "Node CPU by mode",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Node network",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cali.*|tunl.*\"}[5m]))",
     "legendFormat": "receive"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|cali.*|tunl.*\"}[5m]))",
     "legendFormat": "transmit"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 6,
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "Workloads",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Deployments: desired vs available",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace, deployment) (kube_deployment_spec_replicas{namespace=~\"sample-app|apisix|observability\"})",
     "instant": true,
     "format": "table",
     "legendFormat": "desired"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace, deployment) (kube_deployment_status_replicas_available{namespace=~\"sample-app|apisix|observability\"})",
     "instant": true,
     "format": "table",
     "legendFormat": "available"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 7
   }
  },
  {
   "type": "timeseries",
   "title": "Container restarts (1h)",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"sample-app|apisix|observability\"}[1h]))",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Pods by phase",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace, phase) (kube_pod_status_phase{namespace=~\"sample-app|apisix|observability\"}) > 0",
     "legendFormat": "{{namespace}} {{phase}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "Containers vs limits (the Grafana OOM would show here first)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Memory used % of limit",
   "description": "Above ~90% the container is close to an OOM kill.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=~\"sample-app|apisix|observability\", container!=\"\", container!=\"POD\"}) / on (namespace, pod, container) group_left max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=~\"sample-app|apisix|observability\", resource=\"memory\"})",
     "legendFormat": "{{pod}}/{{container}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 12,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "CPU used % of limit",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum by (namespace, pod, container) (rate(container_cpu_usage_seconds_total{namespace=~\"sample-app|apisix|observability\", container!=\"\", container!=\"POD\"}[5m])) / on (namespace, pod, container) group_left max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=~\"sample-app|apisix|observability\", resource=\"cpu\"})",
     "legendFormat": "{{pod}}/{{container}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 13,
   "gridPos": {
    "x": 12,
    "y": 31,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "CPU throttling %",
   "description": null,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum by (pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"sample-app|apisix|observability\", container!=\"\"}[5m])) / clamp_min(sum by (pod, container) (rate(container_cpu_cfs_periods_total{namespace=~\"sample-app|apisix|observability\", container!=\"\"}[5m])), 1e-9)",
     "legendFormat": "{{pod}}/{{container}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    }
   },
   "id": 14,
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Memory working set by pod",
