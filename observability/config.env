# Pinned versions and names for the observability stack. Sourced by observability/scripts/*.sh.
# Images are mirrored to SWR together with the gateway's: see IMAGES in ../config.env.

OBS_NAMESPACE=observability
GRAFANA_HOST=grafana.paykoko.pk

# Helm charts (each >= 2 weeks old when pinned, 2026-10-26)
GC_REPO=https://grafana-community.github.io/helm-charts      # grafana, loki, tempo moved here in 2026
GRAFANA_REPO=https://grafana.github.io/helm-charts            # alloy
PC_REPO=https://prometheus-community.github.io/helm-charts    # prometheus
GRAFANA_CHART=13.5.0      # Grafana 13.2.3
LOKI_CHART=18.15.1        # Loki 3.7.8
TEMPO_CHART=3.1.0         # Tempo 3.1.0
ALLOY_CHART=1.13.1        # Alloy v1.20.1
PROMETHEUS_CHART=29.36.1  # Prometheus v3.15.0

