# Pinned versions and names for the APISIX gateway. Sourced by scripts/*.sh.
# Bump versions here only, then run scripts/mirror-images.sh and scripts/install.sh.

# Helm chart (https://charts.apiseven.com). Chart 2.17.1 = APISIX 3.18.0 + ingress controller 2.2.0
CHART_REPO=https://charts.apiseven.com
CHART_VERSION=2.17.1

NAMESPACE=apisix
RELEASE=apisix
APP_NAMESPACE=sample-app

# sky47 SWR mirror (CCE nodes pull from here, not Docker Hub / ghcr)
SWR=swr.pk-isb-1.sky47.com/pk-beta-repo

# Upstream image -> mirrored name. Tags must match helm/values-sky47.yaml.
IMAGES="
apache/apisix:3.18.0-ubuntu
apache/apisix-ingress-controller:2.2.0
ghcr.io/api7/adc:0.27.1
grafana/grafana:13.2.3-distroless
grafana/loki:3.7.8
grafana/tempo:3.1.0
grafana/alloy:v1.20.1
quay.io/prometheus/prometheus:v3.15.0
quay.io/prometheus-operator/prometheus-config-reloader:v0.94.1
ghcr.io/open-telemetry/opentelemetry-operator/autoinstrumentation-java:2.32.0
"
# (the last 7 are the observability stack: observability/README.md)

# Public URL served by the shared ELB (used by smoke tests / cutover)
PUBLIC_URL=https://beta-test.paykoko.pk
